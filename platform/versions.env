# Pinned upstream chart versions. Sourced by scripts/platform.sh and by CI.
# Checked against the live repositories on 2026-09-30; these were the latest releases.
#
# Bump one line at a time, re-run `make platform`, and note the app version you get.

# prometheus-community/kube-prometheus-stack  (Prometheus Operator v0.94.1)
KUBE_PROMETHEUS_STACK_VERSION=91.8.2
KUBE_PROMETHEUS_STACK_REPO=https://prometheus-community.github.io/helm-charts

# open-telemetry/opentelemetry-collector      (collector 0.161.0)
OPENTELEMETRY_COLLECTOR_VERSION=0.174.0
OPENTELEMETRY_COLLECTOR_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts

# jaegertracing/jaeger                        (Jaeger v2.21.0)
JAEGER_VERSION=4.14.0
JAEGER_REPO=https://jaegertracing.github.io/helm-charts

# kedacore/keda                               (KEDA 2.21.0)
KEDA_VERSION=2.21.0
KEDA_REPO=https://kedacore.github.io/charts

# Namespaces
OBSERVABILITY_NAMESPACE=encabulator-observability
KEDA_NAMESPACE=keda

# Release names. The chart's default observability.prometheusUrl and the dashboards'
# datasource assume these.
KUBE_PROMETHEUS_STACK_RELEASE=prometheus-stack
OPENTELEMETRY_COLLECTOR_RELEASE=opentelemetry-collector
JAEGER_RELEASE=jaeger
KEDA_RELEASE=keda
