# Settings for deploying the Encabulator into your own AWS account with `make hub`.
#
#   cp .env.example .env     # .env is gitignored; edit it, never this file
#   make prereqs             # checks the tools, your AWS credentials and the values below
#
# Plain KEY=value lines. A value set on the make command line or in your shell wins over this
# file, and this file wins over the defaults. Leave an optional value empty to use its default.
# AWS credentials do not go here: use your shell or AWS_PROFILE as usual. No secrets go here.
# The hub is built in us-west-2.

# ------------------------------------------------------------------ required

# The IAM Identity Center instance Argo CD signs users in with (a prerequisite: enable
# Identity Center in your account or organization first). Find it with:
#   aws sso-admin list-instances --region <identity-center-region> --no-paginate \
#     --query 'Instances[0].InstanceArn' --output text
# and the identity store id the group commands below need with:
#   aws sso-admin list-instances --region <identity-center-region> --no-paginate \
#     --query 'Instances[0].IdentityStoreId' --output text
# (--no-paginate keeps the output to one line; without it the CLI can add a second line, None.)
IDC_INSTANCE_ARN=arn:aws:sso:::instance/ssoins-0123456789abcdef

# The id of an Identity Center GROUP whose members become Argo CD admins. It must be a group:
# a user id here gives nobody access. List the groups with:
#   aws identitystore list-groups --region <identity-center-region> --no-paginate \
#     --identity-store-id <IdentityStoreId> --query 'Groups[].[GroupId,DisplayName]' --output text
# No group yet? Create one and add yourself (or use the Identity Center console: Groups,
# Create group, then add users):
#   aws identitystore create-group --region <identity-center-region> \
#     --identity-store-id <IdentityStoreId> --display-name encabulator-argocd-admins \
#     --query GroupId --output text
#   aws identitystore get-user-id --region <identity-center-region> \
#     --identity-store-id <IdentityStoreId> \
#     --alternate-identifier '{"UniqueAttribute":{"AttributePath":"userName","AttributeValue":"<your user name>"}}'
#   aws identitystore create-group-membership --region <identity-center-region> \
#     --identity-store-id <IdentityStoreId> --group-id <GroupId> --member-id UserId=<UserId>
ARGOCD_ADMIN_GROUP_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------ optional

# Region of your Identity Center instance, when it is not us-west-2 (it is shown on the
# Identity Center console's Settings page, for example us-east-1). Empty means us-west-2.
IDC_REGION=

# The Git repository and branch Argo CD syncs. Change them to deploy from your own fork.
GIT_REPO_URL=https://github.com/cloud-native-encabulator/encabulator
GIT_REVISION=main

# Only for a private repository: the path to a file (mode 600) that holds a read-only access
# token for it. Put the path here, never the token.
GIT_TOKEN_FILE=

# Where the cluster pulls the service images from. Empty means the public images on GitHub
# Container Registry. `make mirror-images` copies them into Amazon ECR in your account when
# the release is not published there yet, and writes the ECR address here for you.
REGISTRY=

# The container runtime that builds images when they have to be mirrored: docker or finch.
CONTAINER_RUNTIME=docker
