# Build output
bin/
dist/
target/
coverage/
*.out
*.test

# Node
node_modules/
*.tsbuildinfo
.eslintcache

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Helm
charts/*/charts/*.tgz

# Terraform (terraform/brownfield). .terraform.lock.hcl is committed.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
*.auto.tfvars
crash.log

# Local state
.env
.env.*
!.env.example
*.kubeconfig
tmp/

# re:Invent speaker deck (Bento). A built deck embeds Amazon Ember Modern, which is
# internal and embargoed until 2026-11-30, so it must never land in this public repo.
# It is built outside the repo and published to Alcove instead.
*.bento.html
*.prev.bento.html
*.woff
*.woff2
*.ttf
*.otf

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Agent tooling: local agent settings stay out of Git. .kiro/skills is tracked: it is a
# symbolic link to ../.agents/skills (no trailing slash below, a link is not a directory to Git).
.kiro/*
!.kiro/skills
.scramble/
