{
  "name": "@encabulator/kit",
  "version": "1.0.0",
  "description": "Shared TypeScript service kit for the Cloud Native Encabulator",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js",
      "default": "./dist/telemetry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src test",
    "format": "biome check --write src test"
  },
  "dependencies": {
    "@fastify/otel": "0.21.0",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-ioredis": "0.70.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/dockerode": "4.0.1",
    "@types/node": "24.10.3",
    "dockerode": "5.0.1",
    "testcontainers": "12.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
