{
  "name": "encabulation-control-console",
  "version": "1.0.0",
  "private": true,
  "description": "The instrument panel of the Cloud Native Encabulator: a Vue 3 SPA served by a Fastify BFF.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:bff",
    "build:web": "vue-tsc -p tsconfig.web.json --noEmit && vite build",
    "build:bff": "tsc -p tsconfig.bff.json",
    "typecheck": "vue-tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.bff.json --noEmit && vue-tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.dev.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "start": "node dist/bff/server/main.js",
    "dev:fixtures": "tsx dev/fixture-server.ts",
    "dev:bff": "tsx watch --env-file=dev/dev.env dev/bff.ts",
    "dev:web": "vite",
    "dev": "node dev/run-dev.mjs"
  },
  "dependencies": {
    "@encabulator/kit": "file:../../../libs/ts/kit",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@kubernetes/client-node": "^1.4.0",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "d3": "^7.9.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
