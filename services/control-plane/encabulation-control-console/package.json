{
  "name": "encabulation-control-console",
  "version": "0.3.0",
  "description": "Interactive web interface for Cloud Native Encabulator system control",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .vue,.ts --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.0",
    "socket.io-client": "^4.8.0",
    "d3": "^7.9.0",
    "axios": "^1.7.0",
    "@vueuse/core": "^10.9.0",
    "@headlessui/vue": "^1.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "@types/d3": "^7.4.3",
    "typescript": "^5.8.0",
    "vue-tsc": "^2.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
