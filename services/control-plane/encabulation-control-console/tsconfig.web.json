{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/app/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.vue",
    "src/shared/**/*.ts",
    "env.d.ts"
  ],
  "// exclude": "Tests are not shipped and need Node types; tsconfig.test.json covers them.",
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts"]
}
