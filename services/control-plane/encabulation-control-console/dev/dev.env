# DEV ONLY. Never copied into the image; `npm run dev:bff` loads it with
# `node --env-file`. Every upstream points at the fixture server on 9099, which
# answers with the constants in dev/fixture-server.ts.
PORT=8080
LOG_LEVEL=debug
SESSION_SECRET=dev-only-session-secret-not-for-any-cluster
COOKIE_SECURE=false
POD_NAMESPACE=encabulator

PROMETHEUS_URL=http://127.0.0.1:9099
GRAFANA_EXTERNAL_URL=https://grafana.example.invalid/d/encabulator
JAEGER_EXTERNAL_URL=https://jaeger.example.invalid

UNILATERAL_PHASE_DETRACTOR_URL=http://127.0.0.1:9099
DINGLE_ARM_GATEWAY_URL=http://127.0.0.1:9099
CARDINAL_GRAMMETER_URL=http://127.0.0.1:9099
MALAISE_ENGINE_URL=http://127.0.0.1:9099
DEMO_SCENARIO_ORCHESTRATOR_URL=http://127.0.0.1:9099
DIFFERENTIAL_GIRDLESPRING_URL=http://127.0.0.1:9099
PREFABULATED_AMULITE_DEPOT_URL=http://127.0.0.1:9099
HYDROCOPTIC_DATASTORE_URL=http://127.0.0.1:9099
SIDE_FUMBLING_DETECTOR_URL=http://127.0.0.1:9099
NOFER_TRUNNION_DISPATCH_URL=http://127.0.0.1:9099
SINUSOIDAL_RECORDER_URL=http://127.0.0.1:9099

# No cluster in dev mode: the Kubernetes reader reports "no data" and the panel
# says so, which is exactly what it does in a cluster with RBAC misconfigured.

# Fixture pods come from dev/cluster-fixture.ts, not from a cluster.
KUBERNETES_ENABLED=false
