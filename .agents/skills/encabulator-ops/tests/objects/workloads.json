{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": { "name": "dingle-arm-gateway", "namespace": "encabulator" },
  "spec": {
    "replicas": 2,
    "selector": { "matchLabels": { "app.kubernetes.io/name": "dingle-arm-gateway" } },
    "template": {
      "metadata": { "labels": { "app.kubernetes.io/name": "dingle-arm-gateway" } },
      "spec": { "containers": [ { "name": "gateway", "image": "ghcr.io/cloud-native-encabulator/encabulator/dingle-arm-gateway:1.0.4" } ] }
    }
  },
  "status": { "replicas": 2, "updatedReplicas": 2, "unavailableReplicas": 2 }
}
